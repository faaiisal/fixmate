# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies & Package Managers
node_modules/
.pnp/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing & Coverage
/coverage
coverage/
.nyc_output/

# Next.js Build Output - Never push compiled app
/.next/
/out/
/build
/dist
/.dist
.turbo/

# Production Misc
.DS_Store
*.pem
Thumbs.db
.DS_Store?
ehthumbs.db

# Debug Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment Variables - MUST NOT push secrets to GitHub
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
# Allow example file with placeholders only
!.env.example

# Vercel
.vercel/

# TypeScript
*.tsbuildinfo
next-env.d.ts
tsconfig.tsbuildinfo

# OS Files
.DS_Store
Thumbs.db

# Local-only design resources — DO NOT PUSH
fixmate-local/
.stitch/
.local-design/

# Storybook
storybook-static/

# Editor Settings - Don't push personal editor configs (except extensions.json)
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# Optional: Local assets that are large or private
# public/uploads/
# .env.local
