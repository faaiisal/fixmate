# FixMate Environment Variables - Frontend + BetterAuth
# Copy to .env.local and fill values
# For Vercel deployment, set these in Vercel Dashboard → Settings → Environment Variables

# App - For local dev use http://localhost:3000, for production use your Vercel URL e.g. https://fixmate-psi.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="FixMate Precision Repair Platform"
NEXT_PUBLIC_API_URL="http://localhost:8000/api"
# For production, NEXT_PUBLIC_API_URL should be your backend live URL, e.g. https://fixmate-server-snowy.vercel.app/api

# BetterAuth (required for auth) - Must match frontend URL in production
BETTER_AUTH_URL="http://localhost:3000"
# For production: BETTER_AUTH_URL="https://fixmate-psi.vercel.app"
# BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_SECRET=Q5doqz8xGcqocpzMYVSvhjMHpXkD14MI
# Example: openssl rand -base64 32

# MongoDB (required for BetterAuth + app data)
# Either MONGODB_URI or BETTER_AUTH_DB_URL is supported by FixMate frontend.
MONGODB_URI="mongodb+srv://fixmateAdmin:<password>@cluster0.ylwazzi.mongodb.net/fixmatedb"
BETTER_AUTH_DB_URL="mongodb+srv://fixmateAdmin:<password>@cluster0.ylwazzi.mongodb.net/fixmatedb"
MONGODB_DB="fixmatedb"

# Google OAuth (for social login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth (for social login)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Optional Future
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# NEXT_PUBLIC_MAPBOX_TOKEN="pk.your_mapbox_token"
# IMGBB_API_KEY="your_imgbb_key"

# Email (for password reset) - Optional, required for real email delivery
# If not configured, sendEmail will throw and BetterAuth will handle delivery failure
# No new provider like Resend/Brevo - uses SMTP via nodemailer if available
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="your_smtp_user"
# SMTP_PASS="your_smtp_password"
# EMAIL_FROM="noreply@fixmate.com"
